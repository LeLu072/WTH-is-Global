\"Tree Animate\" (https://skfb.ly/oy78T) by Node_λrt is licensed under Creative Commons Attribution (http://creativecommons.org/licenses/by/4.0/).

\"Jigglypuff - Low Poly 3D Pokémon\" (https://skfb.ly/6WBXS) by cenzo is licensed under Creative Commons Attribution-NonCommercial (http://creativecommons.org/licenses/by-nc/4.0/).

\"medieval sceneray\" (https://skfb.ly/6RZrH) by DJMaesen is licensed under Creative Commons Attribution (http://creativecommons.org/licenses/by/4.0/).

\"landscape textures\"  (https://polyhaven.com)  by polyhaven - Custom CC0 (check out and read the https://polyhaven.com/license )"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[shader_globals]

Fresnel_Invert={
"type": "bool",
"value": false
}
Fresnel_power={
"type": "float",
"value": 1.725
}
Opacity_A={
"type": "float",
"value": 0.0
}
Opacity_B={
"type": "float",
"value": 0.0
}
Opacity_C={
"type": "float",
"value": 0.8
}
Opacity_Layers={
"type": "float",
"value": 1.0
}
wetness={
"type": "float",
"value": 0.0
}
wind_speed={
"type": "float",
"value": 6.0
}
wind_strength={
"type": "float",
"value": 1.5
}
wind_direction={
"type": "vec2",
"value": Vector2(1, 0)
}
energy_color={
"type": "color",
"value": Color(1.6459646e-05, 1.0053117, 0.66857326, 1)
}
wind_noise={
"type": "sampler2D",
"value": "res://VFX/textures/T_Noise3dwER.png"
}
